# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# freee app (redirect URI: urn:ietf:wg:oauth:2.0:oob)
FREEE_CLIENT_ID=
FREEE_CLIENT_SECRET=
FREEE_COMPANY_ID=

# Google AI Studio (use a paid-tier key: free-tier inputs may be used to improve Google products)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# `make key` で生成。紛失すると保存済みトークンは復号できず、全員の再連携が必要
FERNET_KEY=

# DB_PATH=./data/bot.db
